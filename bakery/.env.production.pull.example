# Production MySQL credentials for:
#   1) ONE-WAY pull into bakerysf_local (scripts/pull_prod_to_local.php)
#   2) Optional live runtime when USE_PROD_DB=true (php scripts/switch_db.php prod)
# Copy to .env.production.pull and fill in real values. Never commit that file.
# Keep bakery/.env DB_* on 127.0.0.1 / bakerysf_local; flip USE_PROD_DB to switch.

PROD_DB_HOST=mysql.sourflour.org
PROD_DB_PORT=3306
PROD_DB_NAME=bakerysf
PROD_DB_USER=bakerysf
PROD_DB_PASS=change_me_production_pull_only

# Optional: recreate local login after import (or pass on CLI)
# LOCAL_ADMIN_EMAIL=danny@sourflour.org
# LOCAL_ADMIN_CODE=9741
# LOCAL_ADMIN_NAME=Danny
# LOCAL_ADMIN_ROLE=administrator
