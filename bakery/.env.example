# Sour Flour OS / Bakery Manager — environment template
# Copy to .env for local development (never commit .env).
# Production: prefer Apache/DreamHost environment variables or a config
# file outside the document root — do not deploy real secrets in .env on shared hosts.

APP_ENV=local
APP_NAME=Sour Flour OS (Local)

# Must be a clearly non-production database name for local work
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bakerysf_local
DB_USER=bakery_local
DB_PASS=change_me_local_only

BASE_URL=/bakery/

# Email: log|smtp|oauth  (local must use log)
MAIL_DRIVER=log
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=Sour Flour Local
REPLY_TO_EMAIL=noreply@localhost
REPLY_TO_NAME=Sour Flour Local

# Maps: leave empty locally; set MAPS_ENABLED=false to stub UI
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# OAuth: leave empty locally (MAIL_DRIVER=log skips OAuth)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Durable local login (recreated after setup_local_db / seed / prod pull)
LOCAL_ADMIN_EMAIL=danny@sourflour.org
LOCAL_ADMIN_NAME=Danny
LOCAL_ADMIN_ROLE=administrator
LOCAL_ADMIN_PASSWORD=change_me_local_login
