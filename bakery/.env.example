# Sour Flour OS / Bakery Manager — environment template
# Copy to .env for local development (never commit .env).
# Production: prefer Apache/DreamHost environment variables or a config
# file outside the document root — do not deploy real secrets in .env on shared hosts.

APP_ENV=local
# false = bakerysf_local (DB_* below). true = live DreamHost via .env.production.pull (PROD_DB_*).
# Switch: php scripts/switch_db.php local|prod
USE_PROD_DB=false
APP_NAME=Sour Flour OS (Local)

# Must be a clearly non-production database name for local work (used when USE_PROD_DB=false)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bakerysf_local
DB_USER=bakery_local
DB_PASS=change_me_local_only

BASE_URL=/bakery/
# Production deploy path must match the live URL folder (e.g. /bakery/ or /6/). Do not mix paths.

# Email: log|smtp|oauth  (local must use log)
MAIL_DRIVER=log
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=Sour Flour Local
REPLY_TO_EMAIL=noreply@localhost
REPLY_TO_NAME=Sour Flour Local

# Maps: leave empty locally; set MAPS_ENABLED=false to stub UI
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Optional Photo to Text experiment. This is an OpenAI API key, not a Cursor/Codex login token.
# Keep it out of source control. Without it, ai_photo_text.php still supports a Cursor/Codex handoff.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# For GPT-5.6 photo OCR, use none for the quickest, lowest-cost response.
OPENAI_VISION_REASONING_EFFORT=none

# OAuth: leave empty locally (MAIL_DRIVER=log skips OAuth)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Square (ACH invoicing via Invoices API). Use sandbox until end-to-end works.
# Test: php scripts/test_square_connection.php
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# Created after Webhooks → Subscriptions → your endpoint → Show signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Durable local login (recreated after setup_local_db / seed / prod pull)
LOCAL_ADMIN_EMAIL=danny@sourflour.org
LOCAL_ADMIN_NAME=Danny
LOCAL_ADMIN_ROLE=administrator
LOCAL_ADMIN_CODE=0000

# Agent-controlled SF Baker administrator (local fixture only)
SFB_AGENT_ADMIN_EMAIL=sfadmin@sourflour.org
SFB_AGENT_ADMIN_NAME=SFAdmin
SFB_AGENT_ADMIN_CODE=0000
