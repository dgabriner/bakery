# Delivery photos are login-gated. driver_photo.php reads the files.
# Direct web access stays closed. PHP readfile does not use this file.
Options -Indexes
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>
