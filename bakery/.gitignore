storage/deploy/LAST_STAGING_DEPLOY.json
storage/deploy/LAST_BUILT.json
storage/deploy/deploy_file_sizes.json
storage/deploy/PUSH_HISTORY.jsonl
storage/deploy/STAGING_PUSH_HISTORY.jsonl
storage/deploy/pushes/
storage/deploy/staging_pushes/
storage/deploy/auto_push.log
storage/deploy/.push_request
storage/deploy/.push_lock
storage/deploy/.push_worker
storage/deploy/.auto_push_disabled
storage/deploy/.watch_push.pid
.env.production.pull

