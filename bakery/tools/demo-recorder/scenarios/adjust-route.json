{
  "id": "adjust-route",
  "title": { "en": "Adjust the route", "es": "Ajustar la ruta" },
  "description": {
    "en": "Open a real remaining-stop queue, tap a new order, and save.",
    "es": "Abre una cola real de paradas, toca un orden nuevo y guarda."
  },
  "prepare": "adjust-route",
  "viewport": { "width": 390, "height": 844 },
  "captionPosition": "top",
  "slowMo": 320,
  "captionHoldMs": 850,
  "endHoldMs": 2000,
  "steps": [
    {
      "action": "goto",
      "path": "login.php",
      "caption": { "en": "Sign in as staff", "es": "Entra como personal" }
    },
    { "action": "waitForSelector", "selector": "#code" },
    {
      "action": "fill",
      "selector": "#code",
      "value": "{{ADMIN_CODE}}",
      "delay": 200,
      "caption": { "en": "Enter the staff code", "es": "Escribe el código del personal" }
    },
    { "action": "waitForURL", "includes": "index.php" },
    {
      "action": "goto",
      "path": "driver.php?driver_id={{DRIVER_ID}}&date={{DATE}}",
      "caption": {
        "en": "Open a real My Route with remaining stops",
        "es": "Abre Mi ruta real con paradas pendientes"
      }
    },
    { "action": "waitForSelector", "selector": "button.route-btn--adjust.change-next-btn" },
    {
      "action": "click",
      "selector": "button.route-btn--adjust.change-next-btn",
      "caption": { "en": "Tap Adjust route", "es": "Toca Ajustar ruta" }
    },
    { "action": "waitForSelector", "selector": "body.route-adjust-open" },
    {
      "action": "click",
      "selector": "#stopList .stop-item--upcoming .stop-item-name",
      "nth": 0,
      "caption": {
        "en": "Tap a later stop to make it next",
        "es": "Toca una parada posterior para ponerla de siguiente"
      }
    },
    {
      "action": "click",
      "selector": "#routeAdjustSave",
      "force": true,
      "caption": { "en": "Save the new stop order", "es": "Guarda el nuevo orden" }
    },
    {
      "action": "waitForSelector",
      "selector": "#routeSuccessToast:not([hidden])",
      "waitAfter": 1400
    }
  ]
}
